+    ]
+    _SHOWN = "The team grew, fast, from 70 to 80% of releases on time."
+
+    def _answer(self, chunks):
+        deltas = []
+        result, _, _, _, _ = _run(
+            [_response(tool_query="ledger"), _response("".join(chunks), chunks=chunks)],
