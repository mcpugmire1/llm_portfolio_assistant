#!/usr/bin/env bash
# Repo pre-commit checks. Checks added lines only, so existing content is not retroactively blocked.
EMDASH=$(printf '\342\200\224')
status=0

while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in docs/evidence/*) continue ;; esac   # frozen probe output; see .pre-commit-config.yaml
  added=$(git diff --cached -U0 --no-color -- "$f" | grep '^+' | grep -v '^+++')
  [ -z "$added" ] && continue
  if printf '%s\n' "$added" | grep -Fq -e "$EMDASH"; then
    echo "pre-commit: em dash in added lines of $f. Use a colon, comma, or rewrite." >&2
    status=1
  fi
  case "$f" in
    ui/*|app.py)
      if printf '%s\n' "$added" | grep -Eq -e 'st-emotion-cache|\.st-[a-z][a-z0-9]([^a-z0-9-]|$)'; then
        echo "pre-commit: dynamically-hashed Streamlit class in added lines of $f. Target data-testid, data-baseweb, or .st-key-* (CSS Rule 5)." >&2
        status=1
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

# Role check: each docs session commits only its own two files; a dev session commits none of the four.
# MATTGPT_DOCS_SESSION=arch (scripts/arch-sync-session.sh): ARCHITECTURE.md, docs/ADR.md only.
# MATTGPT_DOCS_SESSION=backlog (scripts/backlog-session.sh): BACKLOG.md, CHANGELOG.md only.
# Commits from Matt's own terminal (no CLAUDECODE) are not checked.
ARCH_FILES="ARCHITECTURE.md docs/ADR.md"
BACKLOG_FILES="BACKLOG.md CHANGELOG.md"
if [ -n "$CLAUDECODE" ]; then
  role="${MATTGPT_DOCS_SESSION:-dev}"
  case "$role" in
    arch) allowed="$ARCH_FILES" ;;
    backlog) allowed="$BACKLOG_FILES" ;;
    dev) allowed="" ;;
    *) echo "pre-commit: unknown MATTGPT_DOCS_SESSION value '$role'; launch scripts/arch-sync-session.sh or scripts/backlog-session.sh." >&2; status=1; allowed="" ;;
  esac
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case " $ARCH_FILES $BACKLOG_FILES " in *" $f "*) is_doc=1 ;; *) is_doc=0 ;; esac
    case " $allowed " in *" $f "*) is_allowed=1 ;; *) is_allowed=0 ;; esac
    if [ "$role" = dev ] && [ "$is_doc" = 1 ]; then
      echo "pre-commit: $f is a doc file; only its docs session commits it." >&2; status=1
    elif [ "$role" != dev ] && [ "$is_allowed" = 0 ]; then
      echo "pre-commit: the $role session commits only $allowed; $f is staged." >&2; status=1
    fi
  done < <(git diff --cached --name-only)
fi

exit $status
