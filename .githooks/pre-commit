#!/usr/bin/env bash
# Repo pre-commit checks. Checks added lines only, so existing content is not retroactively blocked.
EMDASH=$(printf '\342\200\224')
status=0

while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in docs/evidence/*) continue ;; esac   # frozen probe output; see .pre-commit-config.yaml
  added=$(git diff --cached -U0 --no-color -- "$f" | grep '^+' | grep -v '^+++')
  [ -z "$added" ] && continue
  if printf '%s\n' "$added" | grep -Fq -e "$EMDASH"; then
    echo "pre-commit: em dash in added lines of $f. Use a colon, comma, or rewrite." >&2
    status=1
  fi
  case "$f" in
    ui/*|app.py)
      if printf '%s\n' "$added" | grep -Eq -e 'st-emotion-cache|\.st-[a-z][a-z0-9]([^a-z0-9-]|$)'; then
        echo "pre-commit: dynamically-hashed Streamlit class in added lines of $f. Target data-testid, data-baseweb, or .st-key-* (CSS Rule 5)." >&2
        status=1
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

exit $status
