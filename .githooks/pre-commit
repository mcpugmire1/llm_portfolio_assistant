#!/usr/bin/env bash
# Repo pre-commit checks. Checks added lines only, so existing content is not retroactively blocked.
EMDASH=$(printf '\342\200\224')
status=0

while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in docs/evidence/*) continue ;; esac   # frozen probe output; see .pre-commit-config.yaml
  added=$(git diff --cached -U0 --no-color -- "$f" | grep '^+' | grep -v '^+++')
  [ -z "$added" ] && continue
  if printf '%s\n' "$added" | grep -Fq -e "$EMDASH"; then
    echo "pre-commit: em dash in added lines of $f. Use a colon, comma, or rewrite." >&2
    status=1
  fi
  case "$f" in
    ui/*|app.py)
      if printf '%s\n' "$added" | grep -Eq -e 'st-emotion-cache|\.st-[a-z][a-z0-9]([^a-z0-9-]|$)'; then
        echo "pre-commit: dynamically-hashed Streamlit class in added lines of $f. Target data-testid, data-baseweb, or .st-key-* (CSS Rule 5)." >&2
        status=1
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

# Role check: a docs session commits only the doc files; a dev session commits none of them.
# Commits from Matt's own terminal (no CLAUDECODE) are not checked.
DOC_FILES="ARCHITECTURE.md docs/ADR.md BACKLOG.md CHANGELOG.md"
if [ -n "$CLAUDECODE" ]; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case " $DOC_FILES " in *" $f "*) is_doc=1 ;; *) is_doc=0 ;; esac
    if [ -n "$MATTGPT_DOCS_SESSION" ] && [ "$is_doc" = 0 ]; then
      echo "pre-commit: the docs session commits only doc files; $f is staged." >&2; status=1
    elif [ -z "$MATTGPT_DOCS_SESSION" ] && [ "$is_doc" = 1 ]; then
      echo "pre-commit: $f is a doc file; only the docs session (scripts/docs-session.sh) commits it." >&2; status=1
    fi
  done < <(git diff --cached --name-only)
fi

exit $status
